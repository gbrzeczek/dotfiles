// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "base_keymap": "JetBrains",
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "format_on_save": "off",
  "relative_line_numbers": "enabled",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "languages": {
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "language_servers": ["angular", "..."],
      "formatter": [],
    },
    "HTML": {
      "language_servers": ["angular", "eslint", "..."],
    },
    "Angular": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "language_servers": ["angular", "eslint", "..."],
      "formatter": [],
    }
  },
  "lsp": {
    "angular": {
      "initialization_options": {
        "angular_language_server_path": "~/Repos/zed-angular/server"
      }
    },
    "typescript-language-server": {
      "initialization_options": {
        "tsserver": {
          "path": "/Users/grzegorzarray/Repos/pos-system/ui/node_modules/typescript/lib/tsserver.js"
        }
      }
    }
  },
}
